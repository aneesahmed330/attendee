# Attendee Docker stack — generated secrets + AWS S3
# Run: ./scripts/init_attendee_env.sh (once)
# AWS keys are synced from meeting-joiner/.env via ./scripts/sync_attendee_env.py

CREDENTIALS_ENCRYPTION_KEY=
DJANGO_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_RECORDING_STORAGE_BUCKET_NAME=
# AWS_AUDIO_CHUNK_STORAGE_BUCKET_NAME=
# AWS_ENDPOINT_URL=   # omit for AWS S3

CHARGE_CREDITS_FOR_BOTS=false

# ── techverx-server only: bots run locally, not on AWS Fargate ──
# Leaving LAUNCH_BOT_METHOD and every ECS_* var UNSET is what makes
# launch_bot() fall through to the local celery "bots" queue
# (attendee-worker-local) instead of calling out to ECS. Do not set them here.

# Docker compose var substitution in dev.docker-compose.yaml — tune together,
# never raise BOTS_CONCURRENCY without also raising BOTS_MEM_LIMIT, or a bot
# can get OOM-killed mid-meeting. See server-migrate-plan.md §4b/§4h for how
# to decide when it's safe to go past the default of 2.
# BOTS_CONCURRENCY=2
# BOTS_MEM_LIMIT=2560m

# Postgres/Redis bind address. Defaults to loopback-only, correct for
# techverx-server (bots run locally, nothing external needs to reach these).
# Only needed if reverting to the old AWS/Fargate setup, where Fargate tasks
# had to reach these from outside the compose network:
# POSTGRES_BIND_IP=172.31.44.122
# REDIS_BIND_IP=172.31.44.122

# ALLOWED_HOSTS, DJANGO_SSL_REQUIRE, DJANGO_DEBUG, EMAIL_HOST_PASSWORD,
# DEFAULT_FROM_EMAIL etc. are also read from this file (settings/development.py)
# but are host-specific secrets/values, not template defaults — set them
# directly on the server, don't add real values here.
